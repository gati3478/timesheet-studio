{
  "name": "timesheet-generator",
  "version": "1.0.0",
  "description": "Georgian-format monthly timesheet generator with interactive calendar and DOCX template filling",
  "license": "MIT",
  "author": "Giorgi Petriashvili",
  "repository": {
    "type": "git",
    "url": "https://github.com/gati3478/timesheet-generator.git"
  },
  "keywords": [
    "timesheet",
    "sveltekit",
    "docx",
    "georgia",
    "document-generation",
    "holidays"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-kit sync && vitest run --config vitest.config.ts",
    "test:unit": "svelte-kit sync && vitest run --config vitest.config.ts tests/unit tests/integration",
    "prepare:template": "node scripts/prepare-template.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.53.3",
    "@types/node": "^20.11.30",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.2",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "cheerio": "^1.0.0-rc.12",
    "date-fns": "^3.6.0",
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.1",
    "xpath": "^0.0.34"
  }
}
