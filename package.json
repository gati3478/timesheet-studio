{
  "name": "timesheet-generator",
  "version": "1.0.0",
  "description": "Georgian-format monthly timesheet generator with interactive calendar and DOCX template filling",
  "license": "MIT",
  "author": "Giorgi Petriashvili",
  "homepage": "https://github.com/gati3478/timesheet-generator#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/gati3478/timesheet-generator.git"
  },
  "bugs": {
    "url": "https://github.com/gati3478/timesheet-generator/issues"
  },
  "keywords": [
    "timesheet",
    "sveltekit",
    "tauri",
    "docx",
    "georgia",
    "document-generation",
    "holidays",
    "desktop-app"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite dev",
    "dev:open": "vite dev --open",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "npm run test:unit",
    "test:unit": "svelte-kit sync && vitest run --config vitest.config.ts",
    "test:coverage": "svelte-kit sync && vitest run --config vitest.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:e2e",
    "prepare:template": "node scripts/prepare-template.mjs",
    "start:prod": "node build",
    "doctor": "node scripts/doctor.mjs",
    "clean": "node scripts/clean.mjs",
    "bundle:sidecar": "node scripts/bundle-sidecar.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run build && npm run bundle:sidecar && tauri build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,svelte,json,css,html,md,yml,yaml}": "prettier --write",
    "*.{ts,js,mjs,cjs,svelte}": "eslint --fix"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.53.0",
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "2.53.3",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@types/node": "^20.11.30",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.15.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.57.1",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "overrides": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "cheerio": "^1.0.0-rc.12",
    "date-fns": "^3.6.0",
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.1",
    "xpath": "^0.0.34"
  }
}
